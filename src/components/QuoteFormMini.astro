---
/**
 * Compact hero variant: address + email only, then hands off to the full form
 * at /contact#quote.
 *
 * The handoff used to be a query string (`/contact?address=…&email=…`), which
 * quietly cost the visitor a full page load: the HTTP cache and the
 * speculation rules both key on the query, so the prerendered /contact was
 * never the page they landed on. The values now travel in sessionStorage
 * (lib/quote-draft.ts) and the URL stays exactly the one Base.astro
 * prerenders — the click lands on an already-painted form.
 *
 * The plain GET form action is the no-JS fallback and still works: the full
 * form reads query params too.
 */
import { GOOGLE_REVIEWS } from '../lib/site'
---

<div class="card p-6 md:p-7">
  <h2 class="font-display text-xl font-bold">Get a free satellite-measured quote</h2>
  <p class="mt-1.5 text-sm text-body">
    We measure your property from satellite imagery — most quotes are ready the same day.
  </p>
  <form class="mt-5 space-y-3" method="get" action="/contact" id="quote-mini">
    <div>
      <label class="label" for="qfm-address">Property address</label>
      <div class="relative" data-address-autocomplete>
        <input
          class="input"
          id="qfm-address"
          name="address"
          type="text"
          required
          minlength="5"
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-controls="qfm-address-listbox"
          aria-autocomplete="list"
          placeholder="Start typing the address…"
        />
        <ul
          class="address-listbox"
          id="qfm-address-listbox"
          role="listbox"
          aria-label="Address suggestions"
          hidden
        ></ul>
      </div>
    </div>
    <div>
      <label class="label" for="qfm-email">Email</label>
      <input
        class="input"
        id="qfm-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
      />
    </div>
    <button type="submit" class="btn-primary w-full">Start my quote</button>
  </form>
  <p class="mt-3 text-center text-[13px] text-body/80">
    Takes about a minute · No obligation · No site visit needed
  </p>
  <a
    href={GOOGLE_REVIEWS.url}
    target="_blank"
    rel="noopener"
    class="mt-3 flex items-center justify-center gap-2 text-[13px] font-medium text-body hover:text-brand-600"
  >
    <span class="flex gap-0.5" aria-hidden="true">
      {[1, 2, 3, 4, 5].map(() => (
        <svg class="h-3.5 w-3.5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9L10 1.5z" />
        </svg>
      ))}
    </span>
    <span>{GOOGLE_REVIEWS.rating} from {GOOGLE_REVIEWS.count} Google reviews</span>
  </a>
</div>

<script>
  import { attachAddressAutocomplete } from '../scripts/quote-form'
  import { saveQuoteDraft } from '../lib/quote-draft'

  const mini = document.getElementById('quote-mini') as HTMLFormElement | null
  const address = document.getElementById('qfm-address') as HTMLInputElement | null
  if (address) attachAddressAutocomplete(address)

  mini?.addEventListener('submit', (event) => {
    event.preventDefault()
    const data = new FormData(mini)
    saveQuoteDraft({
      address: String(data.get('address') ?? '').trim(),
      email: String(data.get('email') ?? '').trim(),
      from: 'hero',
    })
    // Same URL Base.astro prerenders — query-free so the speculation hits.
    window.location.assign('/contact#quote')
  })
</script>
