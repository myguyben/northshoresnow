---
/**
 * Compact hero variant: address + email only, then hands off to the full form
 * at /contact#quote.
 *
 * The handoff used to be a query string (`/contact?address=…&email=…`), which
 * quietly cost the visitor a full page load: the HTTP cache and the
 * speculation rules both key on the query, so the prerendered /contact was
 * never the page they landed on. The values now travel in sessionStorage
 * (lib/quote-draft.ts) and the URL stays exactly the one Base.astro
 * prerenders — the click lands on an already-painted form.
 *
 * The plain GET form action is the no-JS fallback and still works: the full
 * form reads query params too.
 */
import { INSURANCE } from '../lib/site'

interface Props {
  /**
   * 'price' (default) is the current wording everywhere. 'classic' is the
   * card as it read on the live site before the 2026-09-21 overhaul — used
   * only by arm B of the homepage header test (lib/experiment.ts). The form
   * itself, and where it hands off to, is the same in both.
   */
  copy?: 'price' | 'classic'
  /** Element-id prefix, so two cards on one page never share an id. */
  idPrefix?: string
}

const { copy = 'price', idPrefix = 'qfm' } = Astro.props
const classic = copy === 'classic'
const formId = idPrefix === 'qfm' ? 'quote-mini' : `${idPrefix}-form`
---

{/*
  The header promises the range, because the range is what the next screen
  actually shows. It previously read "most quotes are ready in one business
  day", which describes the email that follows and is a weaker promise than
  Only Strata's four business hours — while the thing we do that none of the
  thirteen competitors can went unmentioned on the one element they were
  looking at.

  "Most", not "every": the estimator declines to price some addresses and the
  panel on /thank-you stays hidden when it does.
*/}
<div class="card p-6 md:p-7">
  <h2 class="font-display text-xl font-bold">
    {classic ? 'Get a complimentary quote' : 'What will my property cost?'}
  </h2>
  <p class="mt-1.5 text-sm text-body">
    {
      classic
        ? 'Most quotes are ready in one business day.'
        : 'Most addresses get a price range on the next screen. Free, no obligation.'
    }
  </p>
  <form class="mt-5 space-y-3" method="get" action="/contact" id={formId} data-quote-mini={copy}>
    <div>
      <label class="label" for={`${idPrefix}-address`}>Property address</label>
      <div class="relative" data-address-autocomplete>
        <input
          class="input"
          id={`${idPrefix}-address`}
          name="address"
          type="text"
          required
          minlength="5"
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-controls={`${idPrefix}-address-listbox`}
          aria-autocomplete="list"
          placeholder="Start typing the address…"
        />
        <ul
          class="address-listbox"
          id={`${idPrefix}-address-listbox`}
          role="listbox"
          aria-label="Address suggestions"
          hidden
        ></ul>
      </div>
    </div>
    <div>
      <label class="label" for={`${idPrefix}-email`}>Email</label>
      <input
        class="input"
        id={`${idPrefix}-email`}
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
      />
    </div>
    <button type="submit" class="btn-primary w-full">
      {classic ? 'Start my quote' : 'Show me my price range'}
    </button>
  </form>
  <p class="mt-3 text-center text-[13px] text-body/80">
    {classic ? 'Takes about a minute · No obligation' : 'Takes about a minute · Your address stays with us'}
  </p>
  {/* Ben, 2026-09-20: the star rating came off the commercial surfaces — a
      property manager is reassured by the coverage limit, not by consumer
      reviews. The review wall lives on /residential now. */}
  <p class="mt-3 flex items-center justify-center gap-1.5 text-[13px] font-medium text-body">
    <svg
      class="h-4 w-4 shrink-0 text-brand-600"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.5l5 5 10-11" />
    </svg>
    <span>{INSURANCE.short}</span>
  </p>
</div>

<script>
  import { attachAddressAutocomplete } from '../scripts/quote-form'
  import { trackQuoteHeroSubmit } from '../lib/analytics'
  import { saveQuoteDraft } from '../lib/quote-draft'

  // Every card on the page — the homepage header test renders two (one
  // hidden), and each needs its own autocomplete and submit handler.
  for (const mini of document.querySelectorAll<HTMLFormElement>('form[data-quote-mini]')) {
    const address = mini.querySelector<HTMLInputElement>('input[name="address"]')
    if (address) attachAddressAutocomplete(address)

    mini.addEventListener('submit', (event) => {
      event.preventDefault()
      const data = new FormData(mini)
      saveQuoteDraft({
        address: String(data.get('address') ?? '').trim(),
        email: String(data.get('email') ?? '').trim(),
        from: 'hero',
      })
      // The funnel's first step, tagged with this card's copy — which is the
      // header arm by another name. Fired before the navigation: GA4 sends
      // events as beacons, so it survives the page going away.
      trackQuoteHeroSubmit(mini.dataset.quoteMini === 'classic' ? 'classic' : 'price')
      // Same URL Base.astro prerenders — query-free so the speculation hits.
      window.location.assign('/contact#quote')
    })
  }
</script>
