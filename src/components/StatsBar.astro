---
/**
 * The operating record.
 *
 * These are counted figures, not marketing ones (see STATS in lib/site.ts),
 * so the component says where they come from. An unattributed number and a
 * sourced one look identical until you name the period — naming it is the
 * whole reason these are worth printing.
 */
import { STATS, STATS_PERIOD } from '../lib/site'

interface Props {
  /** Rendered inside the dark hero (white text) or on light background. */
  dark?: boolean
  /** Print the period line. Off inside the hero, where space is tight. */
  attributed?: boolean
}

const { dark = false, attributed = false } = Astro.props
---

<div>
  <dl
    class:list={[
      'grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-4',
      dark ? 'text-white' : 'text-ink-950',
    ]}
  >
    {STATS.map((stat) => (
      /* Figure above label reads better but dd must follow its dt, so the
         pair is ordered correctly in the DOM and flipped for the eye. */
      <div class="flex flex-col-reverse">
        <dt
          class:list={[
            'mt-2 max-w-[14ch] text-sm leading-snug',
            dark ? 'text-body-dark' : 'text-body',
          ]}
        >
          {stat.label}
        </dt>
        <dd class="figure text-[2rem] md:text-[2.5rem]">{stat.value}</dd>
      </div>
    ))}
  </dl>
  {attributed && (
    <p class:list={['mt-6 text-[13px]', dark ? 'text-body-dark/80' : 'text-body/70']}>
      {STATS_PERIOD}
    </p>
  )}
</div>
