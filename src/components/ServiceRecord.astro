---
/**
 * The record, shown rather than promised.
 *
 * Competitive review 2026-09-20: four of thirteen Metro Vancouver
 * contractors promise photo documentation or service reports. Not one shows
 * a single sample, screenshot or portal view anywhere on their site. We had
 * the same hole — "photo-verified service" appears in four places on this
 * site and the visitor never sees what that produces.
 *
 * THE PANEL IS AN EXAMPLE AND SAYS SO, TWICE. It is not a real client's
 * record and must never be dressed as one: no real client name, no real
 * address, no real job id. What IS real is the shape — every field below is
 * a field `lib/pdf/site-report-generator.ts` actually draws, in the order it
 * draws them, using the same spaced-capital labels over hairlines.
 *
 * WHAT IS DELIBERATELY ABSENT: crew notes, inspection results, weather logs
 * and incidents. Those four are internal-only and the generator does not put
 * them on the client's copy either (Ben's rule, 2026-08-28). Showing them
 * here would advertise a document we do not send.
 *
 * A genuine redacted report from a consenting client would beat this. Until
 * there is one, this is the honest version.
 */
import { Image } from 'astro:assets'
import beforePhoto from '../assets/photos/nss-04.jpg'
import afterPhoto from '../assets/photos/nss-07.jpg'

const fields = [
  { label: 'Service', value: 'Snow clearing — plow + walkways' },
  { label: 'Completed', value: '06:12 PST', mono: true },
  { label: 'Crew', value: '2 operators' },
  { label: 'Time on site', value: '41 min', mono: true },
  { label: 'Material applied', value: '80 kg ice melt' },
  { label: 'Location verified', value: 'GPS in / out', mono: true },
]

const photos = [
  { src: beforePhoto, phase: 'Before', stamp: '05:31', alt: 'A commercial lot under snow before clearing' },
  { src: afterPhoto, phase: 'After', stamp: '06:12', alt: 'The same walkway cleared to bare surface and treated' },
]
---

<section class="section bg-frost-50">
  <div class="container-site grid items-center gap-14 lg:grid-cols-[0.95fr_1.05fr]">
    <div>
      <p class="eyebrow">The record</p>
      <h2 class="h2 mt-2">Everyone says photo-verified. Here is what that means.</h2>
      <p class="mt-5 text-lg leading-relaxed">
        Every visit writes itself into a service record as it happens — clock-in, clock-out,
        GPS at both ends, what was applied and photographs of the surface before and after.
        It is generated from the job, not typed up afterwards from memory.
      </p>
      <p class="mt-4">
        That record is what you forward to your insurer, and what a plaintiff's lawyer has
        to argue against when a slip-and-fall claim arrives fourteen months later. Most
        contractors can tell you they attended. Far fewer can prove what they did.
      </p>

      <div class="mt-8 border-l-2 border-brand-500 pl-5">
        <p class="font-display text-lg font-bold text-ink-950">
          Photographed, or you don't pay for it
        </p>
        <p class="mt-1.5 text-[15px]">
          If we cannot show you the record for a visit, you are not charged for that visit.
        </p>
      </div>
    </div>

    {/* The panel borrows the report's own typography: spaced capitals for
        labels, hairlines between rows, mono for anything a reader would
        check against a timestamp. */}
    <figure class="m-0">
      <div class="overflow-hidden rounded-2xl bg-white shadow-card ring-1 ring-frost-200">
        <div class="flex items-center justify-between gap-4 border-b border-frost-200 px-6 py-4">
          <div>
            <p class="text-[11px] font-semibold tracking-[0.16em] text-body/60 uppercase">
              Site service report
            </p>
            <p class="mt-0.5 font-display font-bold text-ink-950">Riverside Business Park</p>
          </div>
          <span
            class="shrink-0 rounded-full bg-frost-100 px-3 py-1 text-[11px] font-bold tracking-[0.12em] text-body uppercase"
          >
            Example
          </span>
        </div>

        {/* Two columns give each value ~120px of text at 390px, which wraps
            "Snow clearing — plow + walkways" to four lines. One column until
            there is room for two. */}
        <dl class="grid grid-cols-1 gap-px bg-frost-200 sm:grid-cols-2">
          {fields.map((field) => (
            <div class="bg-white px-6 py-4">
              <dt class="text-[10.5px] font-semibold tracking-[0.14em] text-body/60 uppercase">
                {field.label}
              </dt>
              <dd
                class:list={[
                  'mt-1 text-[15px] font-medium text-ink-950',
                  field.mono ? 'font-mono tabular-nums' : '',
                ]}
              >
                {field.value}
              </dd>
            </div>
          ))}
        </dl>

        <div class="grid grid-cols-2 gap-px border-t border-frost-200 bg-frost-200">
          {photos.map((photo) => (
            <div class="relative bg-white">
              <Image
                src={photo.src}
                alt={photo.alt}
                width={520}
                class="aspect-[4/3] w-full object-cover"
                loading="lazy"
              />
              <div
                class="absolute inset-x-0 bottom-0 flex items-center justify-between gap-2 bg-ink-950/75 px-3 py-2 text-[11px] font-semibold tracking-wide text-white uppercase"
              >
                <span>{photo.phase}</span>
                <span class="font-mono tabular-nums lowercase">{photo.stamp}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
      <figcaption class="mt-4 text-[13px] leading-relaxed text-body/80">
        An example record, not a client's. The fields and their order are the ones the real
        report carries; your own copy names your property, your crew and your timestamps.
      </figcaption>
    </figure>
  </div>
</section>
