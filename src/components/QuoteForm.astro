---
import { SITE, GOOGLE_REVIEWS } from '../lib/site'

/**
 * Single-step quote form: property address + email + scope of the site.
 * The AI quoting pipeline measures the property from satellite imagery, so
 * the address is the field that matters most — it autocompletes via the
 * Icey address-autocomplete proxy (Google Places under the hood). The scope
 * description feeds the pipeline's scope prompt (which areas get outlined
 * and quoted). Submits JSON to the Icey website-lead endpoint; on failure
 * it degrades to a prefilled mailto (which feeds the same intake via email).
 *
 * Field order and labelling are conversion decisions, not cosmetics:
 *
 * - The three fields that are actually required come first, so the form
 *   reads as a three-question ask. Name and phone sat at the top before,
 *   which made a six-field wall out of a three-field form.
 * - Optional fields are marked "(optional)" and required ones carry no
 *   asterisk. Marking the short list is what reduces perceived effort;
 *   asterisking the long list does the opposite.
 * - Errors render inline under each field (scripts/quote-form.ts) rather
 *   than through native validation bubbles, which vanish on the next tap and
 *   only ever show one field at a time.
 */
---

<div class="card p-6 md:p-8" id="quote">
  <div class="mb-6">
    <h3 class="font-display text-2xl font-bold">Get your free quote</h3>
    <p class="mt-1.5 text-[15px] text-body">
      Three questions, about a minute. We measure the property from satellite imagery and
      price it on the actual serviceable area — most quotes go out the same day.
    </p>
    <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-[13px] font-medium text-body">
      <a
        href={GOOGLE_REVIEWS.url}
        target="_blank"
        rel="noopener"
        class="flex items-center gap-1.5 hover:text-brand-600"
      >
        <span class="flex gap-0.5" aria-hidden="true">
          {[1, 2, 3, 4, 5].map(() => (
            <svg class="h-3.5 w-3.5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
              <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9L10 1.5z" />
            </svg>
          ))}
        </span>
        {GOOGLE_REVIEWS.rating} from {GOOGLE_REVIEWS.count} Google reviews
      </a>
      <span class="flex items-center gap-1.5">
        <svg
          class="h-4 w-4 text-brand-600"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.5l5 5 10-11" />
        </svg>
        Insured &amp; WorkSafeBC registered
      </span>
    </div>
  </div>

  <form id="quote-form" novalidate>
    <div class="space-y-5">
      <div>
        <label class="label" for="qf-address">Property address</label>
        <div class="relative" data-address-autocomplete>
          <input
            class="input"
            id="qf-address"
            name="address"
            type="text"
            required
            minlength="5"
            autocomplete="off"
            role="combobox"
            aria-expanded="false"
            aria-controls="qf-address-listbox"
            aria-autocomplete="list"
            aria-describedby="qf-address-error"
            placeholder="Start typing the address…"
          />
          <ul
            class="address-listbox"
            id="qf-address-listbox"
            role="listbox"
            aria-label="Address suggestions"
            hidden
          ></ul>
        </div>
        <p class="field-error" id="qf-address-error" hidden></p>
      </div>

      <div>
        <label class="label" for="qf-email">Email</label>
        <input
          class="input"
          id="qf-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          inputmode="email"
          aria-describedby="qf-email-error qf-email-suggestion"
          placeholder="you@example.com"
        />
        <p class="field-error" id="qf-email-error" hidden></p>
        <p class="mt-1.5 text-sm text-body" id="qf-email-suggestion" hidden>
          Did you mean
          <button type="button" id="qf-email-fix" class="font-semibold text-brand-600 underline"
          ></button>?
        </p>
      </div>

      <div>
        <label class="label" for="qf-property-type">Property type</label>
        <select class="input" id="qf-property-type" name="propertyType">
          <option value="Commercial" selected>Commercial / Strata</option>
          <option value="Residential">Residential home</option>
        </select>
      </div>

      <div>
        <label class="label" for="qf-scope">What should we clear?</label>
        <p class="mb-2 -mt-0.5 text-sm text-body/80" id="qf-scope-help">
          One sentence is plenty — we'll outline exactly those areas on satellite imagery.
        </p>
        <textarea
          class="input"
          id="qf-scope"
          name="scope"
          rows="3"
          required
          minlength="10"
          maxlength="2000"
          aria-describedby="qf-scope-help qf-scope-error"
          placeholder="e.g. Clear and salt the main parking lot, both entrances and the sidewalks — or for a home: the driveway, front walk and steps…"
        ></textarea>
        <p class="field-error" id="qf-scope-error" hidden></p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label class="label" for="qf-name">
            Your name <span class="font-normal text-body/70">(optional)</span>
          </label>
          <input
            class="input"
            id="qf-name"
            name="name"
            type="text"
            maxlength="150"
            autocomplete="name"
            placeholder="Jane Smith"
          />
        </div>
        <div>
          <label class="label" for="qf-phone">
            Phone <span class="font-normal text-body/70">(optional)</span>
          </label>
          <input
            class="input"
            id="qf-phone"
            name="phone"
            type="tel"
            maxlength="30"
            inputmode="tel"
            autocomplete="tel"
            placeholder="604-555-0100"
          />
        </div>
      </div>

      <div>
        <label class="label" for="qf-attachment">
          Site map or scope document <span class="font-normal text-body/70">(optional)</span>
        </label>
        <p class="mb-2 -mt-0.5 text-sm text-body/80">
          A photo, plan, or marked-up map of what you'd like cleared — our system will
          follow it exactly.
        </p>
        <input
          class="input !py-2.5 file:mr-3 file:rounded-lg file:border-0 file:bg-ink-950/5 file:px-3 file:py-1.5 file:text-sm file:font-semibold"
          id="qf-attachment"
          name="attachment"
          type="file"
          accept="image/*,.pdf"
          multiple
        />
        <p id="qf-attachment-status" class="mt-1.5 text-sm text-body/80" hidden></p>
      </div>

      <!-- Honeypot: humans never see or fill this. -->
      <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
        <label for="qf-website">Website</label>
        <input id="qf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
    </div>

    <div
      id="qf-error"
      hidden
      class="mt-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800"
    >
      <p class="font-semibold">We couldn't send your request automatically.</p>
      <p class="mt-1">
        Email us instead — one click, your details are already filled in:
        <a id="qf-mailto" class="font-semibold underline" href={`mailto:${SITE.email}`}>
          {SITE.email}
        </a>
        or call
        <a class="font-semibold underline" href={SITE.phoneHref}>{SITE.phone}</a>.
      </p>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
      <p class="max-w-xs text-[13px] leading-relaxed text-body/80">
        By requesting a quote you agree to be contacted about your property. We never share
        your details.
      </p>
      <button type="submit" id="qf-submit" class="btn-primary shrink-0 !px-8">
        <svg
          id="qf-spinner"
          class="h-4 w-4 animate-spin"
          viewBox="0 0 24 24"
          fill="none"
          hidden
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" class="opacity-25"
          ></circle>
          <path fill="currentColor" class="opacity-90" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
        </svg>
        <span id="qf-submit-label">Get my quote</span>
      </button>
    </div>

    <div
      class="mt-5 grid gap-2 border-t border-frost-200 pt-5 text-[13px] text-body sm:grid-cols-3"
    >
      {
        [
          'Free, with no obligation',
          'Usually a ballpark range on the spot',
          'Full quote by email, same day',
        ].map((line) => (
          <p class="flex items-start gap-1.5">
            <svg
              class="mt-0.5 h-3.5 w-3.5 shrink-0 text-brand-600"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.5l5 5 10-11" />
            </svg>
            {line}
          </p>
        ))
      }
    </div>
  </form>
</div>

<script>
  import { setupQuoteForm } from '../scripts/quote-form'
  setupQuoteForm()
</script>
