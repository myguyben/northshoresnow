---
import { SITE } from '../lib/site'

interface Props {
  title: string
  description: string
  /** Path beginning with '/', or full URL. Defaults to current pathname. */
  canonical?: string
  ogImage?: string
  ogType?: 'website' | 'article'
  noindex?: boolean
}

const {
  title,
  description,
  canonical,
  ogImage = SITE.defaultOgImage,
  ogType = 'website',
  noindex = false,
} = Astro.props

// With build.format 'file', Astro.url.pathname is '/foo.html' — canonicals
// must always be the clean extensionless URL the site actually serves.
const path = (canonical ?? Astro.url.pathname)
  .replace(/index\.html$/, '')
  .replace(/\.html$/, '')
const canonicalUrl = path.startsWith('http')
  ? path
  : new URL(path === '/' || path === '' ? '/' : path.replace(/\/$/, ''), SITE.url).href
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, SITE.url).href

/**
 * Staging kill-switch. The preview site on Render builds this same repo from
 * a branch, and without this it would serve a byte-identical copy of the
 * whole site on a second hostname — duplicate content Google is free to index
 * and rank against northshoresnow.com.
 *
 * Driven by an env var rather than a committed file so it can never reach
 * production by being merged: PUBLIC_NOINDEX is set ONLY on the preview
 * service. Unset everywhere else, so main is unaffected.
 */
const forceNoindex = import.meta.env.PUBLIC_NOINDEX === '1'
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{(noindex || forceNoindex) && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_CA" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
