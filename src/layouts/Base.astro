---
import '../styles/global.css'
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'
import bricolageWoff2 from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url'
import '@fontsource-variable/inter'
import '@fontsource-variable/bricolage-grotesque'
import Seo from '../components/Seo.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Analytics from '../components/Analytics.astro'
import MobileCallBar from '../components/MobileCallBar.astro'

interface Props {
  title: string
  description: string
  canonical?: string
  ogImage?: string
  ogType?: 'website' | 'article'
  noindex?: boolean
  /** Home passes true: transparent header over the dark hero. */
  overHero?: boolean
}

const { overHero = false, ...seo } = Astro.props

/**
 * Prerender the quote page from every other page.
 *
 * "Get a Quote" is the only click on this site that makes money, and it was
 * paying full freight: a Cloudflare round-trip, then a parse, then a paint,
 * on a phone in a parking lot. The speculation rule builds /contact#quote in
 * the background as soon as this page loads, so the click swaps to a page
 * that is already painted.
 *
 * The URL carries the #quote fragment because every CTA on the site links
 * there (Header, Footer, CtaBand, MobileCallBar, HeroPage, PricingCards) and
 * the hero mini form now navigates there too — one URL, so it matches
 * whether or not the browser ignores fragments when matching a speculation.
 *
 * Everything else gets a plain `prefetch` on hover ("moderate"), which is
 * document-only and costs nothing until intent is shown.
 *
 * Prerendering runs the target page's scripts before the click, so anything
 * that counts a visit has to wait for activation — see lib/prerender.ts,
 * Analytics.astro and scripts/quote-form.ts.
 */
// build.format 'file' means pathname is '/contact.html'.
const path = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '')
const speculate = path !== '/contact' && path !== '/thank-you'
const SPECULATION_RULES = JSON.stringify({
  prerender: [{ source: 'list', urls: ['/contact#quote'], eagerness: 'immediate' }],
  prefetch: [
    // Belt and braces: the same URL as a plain prefetch. Prerender is the
    // better experience but is the first thing a browser drops (data saver,
    // low memory, an extension holding the request pipeline); a prefetch
    // still removes the whole network round-trip from the click, and a
    // browser that does both uses the prerender and ignores this.
    { source: 'list', urls: ['/contact#quote'], eagerness: 'immediate' },
    {
      source: 'document',
      where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/contact*' } }] },
      eagerness: 'moderate',
    },
  ],
})
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bricolageWoff2} crossorigin />
    <Seo {...seo} />
    <Analytics />
    {
      speculate && (
        <Fragment>
          <script type="speculationrules" is:inline set:html={SPECULATION_RULES} />
          {/* Firefox has no speculation rules but does honour rel=prefetch;
              only injected where the rules were ignored, so Chromium never
              fetches the quote page twice. Safari supports neither and is
              left with the normal navigation. */}
          <script is:inline>
            if (
              !(
                window.HTMLScriptElement &&
                HTMLScriptElement.supports &&
                HTMLScriptElement.supports('speculationrules')
              )
            ) {
              var link = document.createElement('link')
              link.rel = 'prefetch'
              link.href = '/contact'
              document.head.appendChild(link)
            }
          </script>
        </Fragment>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-ink-950"
    >
      Skip to content
    </a>
    <Header overHero={overHero} />
    <main id="main" class:list={[overHero ? '' : 'pt-[72px]']}>
      <slot />
    </main>
    <Footer />
    <MobileCallBar />

    <!-- Runs with or without pixels configured: a lead still has to carry its
         UTMs and click id into Icey so the sale can be traced back to the ad. -->
    <script>
      import { initAnalytics } from '../lib/analytics'
      initAnalytics()
    </script>
  </body>
</html>
