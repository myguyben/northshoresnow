---
import Base from '../layouts/Base.astro'
import { SITE } from '../lib/site'
---

<Base
  title="Request Received | North Shore Snow"
  description="Your quote request has been received. We're measuring your property now — expect your quote shortly."
  noindex
>
  <section class="hero-dark flex min-h-[75vh] items-center pt-[72px]">
    <div class="container-site max-w-3xl py-20 text-center">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand-600">
        <svg class="h-8 w-8 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.5l5 5 10-11" />
        </svg>
      </div>
      <h1 class="h1 mt-7 !text-white">Request received — we're on it</h1>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-body-dark">
        Our system is already measuring your property from satellite imagery. You'll get a
        confirmation email within minutes, and your quote is usually ready the same day.
      </p>
      <div
        id="ballpark"
        hidden
        class="mx-auto mt-8 max-w-xl rounded-2xl border border-ice-400/40 bg-white/5 p-6"
      >
        <p class="text-sm font-semibold uppercase tracking-wide text-ice-400">
          Your ballpark range
        </p>
        <p class="mt-2 text-2xl font-bold text-white">
          <span id="ballpark-visit"></span>
          <span class="font-normal text-body-dark"> per visit</span>
        </p>
        <p class="mt-1 text-lg font-semibold text-white">
          <span id="ballpark-season"></span>
          <span class="font-normal text-body-dark"> per season</span>
        </p>
        <p class="mt-3 text-sm text-body-dark">
          Based on your property type and lot records — your exact quote, measured from
          satellite imagery, arrives by email.
        </p>
      </div>
      <div class="mx-auto mt-10 grid max-w-lg gap-3 text-left">
        {[
          ['Check your inbox', 'A confirmation from our team is on its way (check spam the first time).'],
          ['We measure + price', 'Satellite measurement and local routing — no site visit needed.'],
          ['Your quote arrives', 'Clear seasonal and per-event options, ready to sign digitally.'],
        ].map(([title, body], i) => (
          <div class="flex gap-4 rounded-2xl border border-white/10 bg-white/5 p-5">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ice-400 text-sm font-bold text-ink-950">
              {i + 1}
            </span>
            <div>
              <p class="font-semibold text-white">{title}</p>
              <p class="mt-0.5 text-sm text-body-dark">{body}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="mt-10 text-body-dark">
        Urgent? Call us directly at
        <a href={SITE.phoneHref} class="font-bold text-white underline decoration-ice-400 underline-offset-4">
          {SITE.phone}
        </a>
      </p>
    </div>
  </section>

  <script>
    import { consumePendingLead, trackLead, LEAD_VALUE } from '../lib/analytics'

    // Only a real submission leaves a pending lead behind, so someone who
    // lands here by any other route is not counted as a conversion.
    const lead = consumePendingLead()
    if (lead) {
      const value =
        lead.propertyType === 'Residential' ? LEAD_VALUE.residential : LEAD_VALUE.commercial
      void trackLead({
        eventId: lead.submissionId,
        value,
        propertyType: lead.propertyType,
        email: lead.email,
      })

      // Instant ballpark from the submit response (absent = server declined
      // to price; the panel just stays hidden and the promise stays "by email").
      const est = lead.estimate
      if (est && est.perVisit && est.seasonal) {
        const money = (n: number) => '$' + Math.round(n).toLocaleString('en-CA')
        const range = (r: { low: number; high: number }) => `${money(r.low)}–${money(r.high)}`
        const visit = document.getElementById('ballpark-visit')
        const season = document.getElementById('ballpark-season')
        const panel = document.getElementById('ballpark')
        if (visit && season && panel) {
          visit.textContent = range(est.perVisit)
          season.textContent = range(est.seasonal)
          panel.hidden = false
        }
      }
    }
  </script>
</Base>
