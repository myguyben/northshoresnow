---
import { Image, getImage } from 'astro:assets'
import Base from '../layouts/Base.astro'
import LogoMarquee from '../components/LogoMarquee.astro'
import InsuranceStrip from '../components/InsuranceStrip.astro'
import QuoteFormMini from '../components/QuoteFormMini.astro'
import StatsBar from '../components/StatsBar.astro'
import PricingCards from '../components/PricingCards.astro'
import ResponseCommitment from '../components/ResponseCommitment.astro'
import FaqAccordion from '../components/FaqAccordion.astro'
import CtaBand from '../components/CtaBand.astro'
import LocalBusinessSchema from '../components/schema/LocalBusinessSchema.astro'
import { AREA_LINKS } from '../lib/site'
import heroPhoto from '../assets/photos/nss-01.jpg'
import plowPhoto from '../assets/photos/nss-04.jpg'
import sidewalkPhoto from '../assets/photos/nss-07.jpg'

const heroBg = await getImage({ src: heroPhoto, format: 'webp', width: 1600, quality: 70 })

/**
 * THIS PAGE IS NEUTRAL. Ben, 2026-09-21: "the home page is commercial
 * focussed — homepage should be neutral and then we should have a
 * commercial and residential page."
 *
 * The two audiences want different things and neither is served by a page
 * that addresses the other. So the homepage sells only what is true for
 * both — the instant price, the response windows, the record, the cover —
 * and forks to /commercial and /residential, which are where the specifics
 * live and are already written for their own reader.
 *
 * WHEN EDITING ANYTHING HERE, ask whether a homeowner and a strata manager
 * would both read it as written for them. "Before business hours",
 * "parking lots", "loading zones", "your council" are all for /commercial.
 */
/**
 * TWO SERVICES, BECAUSE THERE ARE TWO. Ben, 2026-09-22: "you have salting
 * section twice."
 *
 * He is right, and it was worse than a repeated card. The grid showed
 * "De-Icing & Anti-Icing" and "Salting & Ice Melt" as separate offerings
 * when they are one operation described twice — and that misrepresents how
 * the business actually works. A visit is snow OR de-icing, each at its own
 * rate; that is the rule the whole pricing engine is built on, and the
 * homepage was contradicting it.
 *
 * The four service PAGES stay as they are — people search "snow plowing"
 * and "salting" separately and those pages target those phrases. They are
 * now reached as sub-services from the card they belong under, which also
 * gives the homepage its first contextual internal links with descriptive
 * anchors instead of nav boilerplate.
 */
const services = [
  {
    href: '/snow-removal',
    title: 'Snow clearing',
    body: 'Plowing, shovelling and hauling the moment accumulation hits your trigger depth — lots, driveways, walkways and entrances cleared before you need them.',
    photo: plowPhoto,
    alt: 'North Shore Snow plow truck pushing snow across a parking lot during a snowfall',
    includes: [
      { href: '/snow-removal', label: 'Full snow removal' },
      { href: '/snow-plowing', label: 'Parking lot plowing' },
    ],
  },
  {
    href: '/de-icing',
    title: 'Ice control',
    body: 'Liquid brine before a freeze and granular melt after one, whenever temperatures reach 0°C — stopping ice forming rather than treating it once someone has slipped.',
    // The spreader, not a plough. The ice-control card was showing a plough
    // truck on a cleared lot, which is a picture of the OTHER service.
    photo: sidewalkPhoto,
    alt: 'North Shore Snow crew member spreading ice melt along a cleared walkway',
    includes: [
      { href: '/de-icing', label: 'De-icing & anti-icing' },
      { href: '/salting', label: 'Salting & ice melt' },
    ],
  },
]

/**
 * The fork. It sits directly under the hero, before the client logos —
 * a homeowner should be told there is a path for them BEFORE they scroll
 * past a strip of corporate logos and conclude they are on the wrong site.
 */
const audiences = [
  {
    href: '/commercial',
    eyebrow: 'For businesses, strata & property managers',
    title: 'Commercial & strata',
    // Its own label rather than one derived from the title — "See how
    // homes & driveways works" does not agree with itself.
    cta: 'See how commercial service works',
    body: 'Parking lots, walkways, loading docks and common areas, on a documented plan your council or owners can hold us to.',
    points: [
      'Bylaw sidewalk frontage built into the plan',
      'Photo-verified records for every visit',
      'Seasonal contracts with a stated response window',
    ],
  },
  {
    href: '/residential',
    eyebrow: 'For homeowners',
    title: 'Homes & driveways',
    cta: 'See how home service works',
    body: 'Your driveway, walkways, steps and sidewalk frontage — cleared automatically when it snows, whether you are home or not.',
    points: [
      'No call needed — we dispatch on the forecast',
      'Photo of the finished work after each visit',
      'Per-visit or a fixed seasonal plan, cancel on 30 days',
    ],
  },
]

const homeFaqs = [
  {
    q: 'How fast can I get a quote?',
    a: 'Most addresses get a price range immediately — enter the property address and the range appears on the confirmation screen, before anyone contacts you. The exact quote, measured from satellite imagery and priced on your actual serviceable area, follows by email usually within one business day.',
  },
  {
    q: 'Do you work on homes as well as commercial properties?',
    a: 'Both, on the same crews and the same weather triggers. Commercial, strata and multi-family covers parking lots, sidewalks, loading zones and common areas; home service covers the driveway, walkways, steps and your sidewalk frontage. The agreements differ because the two need different things written down — see the commercial page or the residential page for how each works.',
  },
  {
    q: 'What triggers a service visit?',
    a: 'Seasonal contracts include automatic dispatch on snowfall accumulation triggers and proactive de-icing whenever temperatures reach 0°C. You never need to call us out — we are already on the way.',
  },
  {
    q: 'Which areas do you cover?',
    a: 'The entire North Shore — North Vancouver, West Vancouver, Lynn Valley, Deep Cove, Edgemont, Lonsdale — plus Downtown Vancouver, Burnaby and Richmond. See our service areas page for the full list.',
  },
  {
    q: 'Are you insured?',
    a: 'Yes. We carry Commercial General Liability insurance of not less than CAD $5,000,000 per occurrence, and we are WorkSafeBC registered. Certificates of insurance are available on request with your quote.',
  },
]
---

<Base
  {/*
    The homepage no longer targets "commercial snow removal" — /commercial
    does, with its own title and its own copy, which is the better place for
    it anyway: one page per intent beats one page hedging two. This one
    names both audiences and leads with the thing neither competitor nor
    keyword can match.
  */}
  title="North Shore Snow | Snow Removal & Ice Management, Greater Vancouver"
  description="Snow clearing, salting and de-icing for commercial, strata and residential property across Greater Vancouver. Most addresses priced instantly."
  overHero
>
  <link slot="head" rel="preload" as="image" href={heroBg.src} fetchpriority="high" />

  {/*
    HEADER A/B TEST — see lib/experiment.ts. The assignment runs in the
    head-first slot: before the body is painted, so the arm is decided before
    either header is visible (no flash of A turning into B), and before
    <Analytics />, so the first page_view a new visitor ever sends already
    carries the home_hero user property — Analytics.astro reads the arm from
    localStorage as it configures the tag, and it used to run first. This
    script cannot import lib/experiment.ts, so the storage key and names are
    written out here; keep them in step.
  */}
  <script is:inline slot="head-first">
    ;(function () {
      var KEY = 'nss_exp_home_hero'
      var v = null
      try {
        var forced = new URLSearchParams(location.search).get('hero')
        var bot = /bot|crawl|spider|slurp|lighthouse|headless/i.test(navigator.userAgent)
        if (forced === 'a' || forced === 'b') v = forced
        else if (bot) v = 'a'
        else {
          v = localStorage.getItem(KEY)
          if (v !== 'a' && v !== 'b') v = Math.random() < 0.5 ? 'a' : 'b'
        }
        if (!bot) localStorage.setItem(KEY, v)
      } catch (e) {
        // Storage blocked: still a fair coin. Defaulting to A here tilted the
        // test — every browser that refuses storage landed in the same arm.
        v = v || (Math.random() < 0.5 ? 'a' : 'b')
      }
      document.documentElement.setAttribute('data-hero', v)
    })()
  </script>
  <style is:inline slot="head-first">
    html:not([data-hero='b']) [data-hero-variant='b'],
    html[data-hero='b'] [data-hero-variant='a'] {
      display: none;
    }
  </style>
  {/*
    The denominator event stays in the ordinary head slot, after <Analytics />:
    gtag has to exist. The user property is Analytics.astro's job now; the
    parameter on the event is belt and braces. Same prerender gate as the tags
    — Chrome prerenders a homepage straight from the search results page, and
    a view nobody opened must not count.
  */}
  <script is:inline slot="head">
    ;(function () {
      var v = document.documentElement.getAttribute('data-hero')
      if (!v || !window.gtag) return
      function experimentView() {
        window.gtag('event', 'experiment_view', { experiment: 'home-hero', variant: v, home_hero: v })
      }
      if (document.prerendering) {
        document.addEventListener('prerenderingchange', experimentView, { once: true })
      } else {
        experimentView()
      }
    })()
  </script>

  <!-- HERO, arm A (the new header) — see lib/experiment.ts -->
  <section
    data-hero-variant="a"
    class="hero-dark relative overflow-hidden"
    style={`background-image: linear-gradient(180deg, rgb(10 20 32 / 0.68), rgb(10 20 32 / 0.9)), radial-gradient(600px at 80% 0%, rgb(99 201 245 / 0.14), transparent), url(${heroBg.src}); background-size: cover; background-position: center;`}
  >
    <div class="container-site grid items-center gap-12 pt-[128px] pb-16 md:pb-24 lg:grid-cols-[1.05fr_0.95fr] lg:pt-[152px]">
      <div>
        {/* Ben, 2026-09-21: "commercial" off, and Greater Vancouver rather
            than naming the North Shore first. The site still sells to
            commercial buyers — the industry pages and the whole proof
            section say so — but the top line no longer turns a homeowner
            away before they read it, and the area now reads as the whole
            region instead of one suburb plus a city. */}
        <p class="eyebrow-dark">Snow &amp; ice management · Greater Vancouver</p>
        <h1 class="h1 mt-4 !text-white">
          See what your property costs
          <span class="text-gradient-ice">before anyone calls you back.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-body-dark">
          {/*
            NOT "no site visit needed" — that phrase was removed site-wide on
            2026-08-26 after sales objected, and it was reintroduced here by
            mistake. A strata council carries a statutory duty of care and has
            to justify the award to owners; for them the site walk is a trust
            ritual, not an inefficiency, and telling them we skip it reads as
            a corner cut. The advantage is that you do not WAIT on a visit to
            see a price — not that no one ever comes.
          */}
          Type the address. We measure the property from satellite imagery and show you a
          price range on the next screen, so you get a number without waiting on a site
          visit. Your exact, measured quote follows by email.
        </p>
        <ul class="mt-8 flex flex-wrap gap-x-7 gap-y-3 text-[15px] text-body-dark">
          {[
            'Most addresses priced instantly',
            'Exact quote within one business day',
            'No obligation',
          ].map((point) => (
            <li class="flex items-center gap-2">
              <svg
                class="h-4 w-4 shrink-0 text-brand-400"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 8.5l3.5 3.5 7.5-8" />
              </svg>
              {point}
            </li>
          ))}
        </ul>
        <p class="mt-8 text-[15px] text-body-dark">
          Already know what you need?
          <a
            href="/services"
            class="ml-1 font-semibold text-brand-400 underline decoration-brand-400/40 underline-offset-4 hover:decoration-brand-400"
          >
            See every service
          </a>
        </p>
      </div>
      <div class="lg:w-full lg:max-w-md lg:justify-self-end">
        <QuoteFormMini />
      </div>
    </div>
  </section>

  {/*
    HERO, arm B — the header as it read on the live site before the
    2026-09-21 overhaul, stat bar included (Ben chose verbatim, 2026-09-23),
    then trimmed the same day: no buttons, and the eyebrow matches arm A's
    "Snow & ice management · Greater Vancouver".
    Everything below is the new page in both arms. When the test is decided,
    delete the losing arm, StatsBar if B loses, and the head script above.
  */}
  <section
    data-hero-variant="b"
    class="hero-dark relative overflow-hidden"
    style={`background-image: linear-gradient(180deg, rgb(10 20 32 / 0.68), rgb(10 20 32 / 0.9)), radial-gradient(600px at 80% 0%, rgb(99 201 245 / 0.14), transparent), url(${heroBg.src}); background-size: cover; background-position: center;`}
  >
    <div class="container-site grid items-center gap-12 pt-[128px] pb-16 md:pb-24 lg:grid-cols-[1.2fr_0.8fr] lg:pt-[152px]">
      <div>
        <p class="eyebrow !text-ice-300">Snow &amp; ice management · Greater Vancouver</p>
        {/* A <p>, not a second <h1>: both headers are in the HTML and only one
            is shown, so this borrows the heading's look and role instead. */}
        <p
          class="h1 mt-4 !text-white font-display font-[650] tracking-[-0.02em] [text-wrap:balance]"
          role="heading"
          aria-level="1"
        >
          Snow cleared before <span class="text-gradient-ice">business hours.</span>
          Every storm. Guaranteed.
        </p>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-body-dark">
          Strata councils, property managers and businesses across the North Shore trust us
          to keep parking lots, sidewalks and entrances safe all winter, with
          photo-verified service after every visit.
        </p>
        <div class="mt-12 border-t border-white/10 pt-8">
          <StatsBar dark />
        </div>
      </div>
      <div class="lg:justify-self-end lg:w-full lg:max-w-md">
        <QuoteFormMini copy="classic" idPrefix="qfm-b" />
      </div>
    </div>
  </section>

  {/* THE FORK — see the `audiences` comment above for why it is here. */}
  <section class="section bg-white">
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="eyebrow">Who we work for</p>
        <h2 class="h2 mt-2">Two kinds of property, two ways we work</h2>
        <p class="mt-4 text-lg">
          The same crews, the same weather triggers and the same records — but a strata
          council and a homeowner need different things written down, so each has its own
          plan and its own agreement.
        </p>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        {audiences.map((audience) => (
          <a href={audience.href} class="card card-hover group flex flex-col p-8">
            <p class="eyebrow">{audience.eyebrow}</p>
            <h3 class="mt-2 font-display text-2xl font-bold group-hover:text-brand-600">
              {audience.title}
            </h3>
            <p class="mt-3 text-[15px] leading-relaxed">{audience.body}</p>
            <ul class="mt-6 flex-1 space-y-2.5">
              {audience.points.map((point) => (
                <li class="flex gap-3 text-[15px]">
                  <svg
                    class="mt-1 h-4 w-4 shrink-0 text-brand-500"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 8.5l3.5 3.5 7.5-8" />
                  </svg>
                  {point}
                </li>
              ))}
            </ul>
            <span class="mt-7 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600">
              {audience.cta}
              <svg
                class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8h10M9 4l4 4-4 4" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/*
    WHO, NOT HOW MANY.

    A counted stat bar sat here — 766 visits, 61 properties — and came out on
    Ben's call: "our numbers aren't high enough to advertise them, 60 sites
    is nothing." An accurate figure that loses the comparison is worse than
    no figure, because it invites the comparison. The logos are the proof
    instead, and the coverage line under them is the other half: names a
    buyer recognises, and the cover behind them. See lib/site.ts — do not
    reintroduce volume statistics.
  */}
  <LogoMarquee />

  <InsuranceStrip />

  <!-- SERVICES -->
  <section class="section bg-white">
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="eyebrow">What we do</p>
        <h2 class="h2 mt-2">Two services, and a visit is one or the other</h2>
        <p class="mt-4 text-lg">
          Snow clearing and ice control are dispatched on their own triggers and priced at
          their own rates — because a cold, clear morning needs salt and no plough, and you
          should not be billed as though it needed both.
        </p>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {services.map((service) => (
          <div class="card group overflow-hidden">
            <a href={service.href} class="block overflow-hidden" tabindex="-1" aria-hidden="true">
              <div class="aspect-[16/9] overflow-hidden">
                <Image
                  src={service.photo}
                  alt={service.alt}
                  width={880}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  loading="lazy"
                />
              </div>
            </a>
            <div class="p-7 md:p-8">
              <h3 class="font-display text-2xl font-bold">
                <a href={service.href} class="hover:text-brand-600">{service.title}</a>
              </h3>
              <p class="mt-3 text-[15px] leading-relaxed">{service.body}</p>
              {/* Contextual links with descriptive anchors — the sub-service
                  pages still target "snow plowing" and "salting" in search,
                  and this is the only place on the homepage they are linked
                  from anything other than nav boilerplate. */}
              <ul class="mt-6 flex flex-wrap gap-2.5 border-t border-frost-100 pt-5">
                {service.includes.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="inline-flex items-center gap-1.5 rounded-full border border-frost-200 px-3.5 py-1.5 text-sm font-medium text-ink-900 transition-colors hover:border-brand-500 hover:text-brand-600"
                    >
                      {item.label}
                      <svg class="h-3 w-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8h10M9 4l4 4-4 4" />
                      </svg>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
      <p class="mt-8 text-[15px]">
        Salt is inside the price, not added to your invoice afterwards —
        <a href="/services" class="font-semibold text-brand-600 hover:underline">see how both services are priced</a>.
      </p>
    </div>
  </section>

  {/*
    "Why North Shore Snow" — four cards numbered 01–04 — used to sit here and
    has been removed rather than restyled. Its four claims were "measured not
    guessed" (now the hero's entire thesis), "proactive dispatch" and "24/7
    storm coverage" (both said properly, with hours attached, in
    ResponseCommitment), and "photo-verified service" (now shown rather than
    asserted in ServiceRecord). Keeping it meant making each claim twice, the
    weaker time first, in the fifth identical card grid on the page. The
    numbering was decoration too: 01–04 implies a sequence and there was none.
  */}
  {/*
    A mock service-record panel sat here — an example report with an invented
    property name and an EXAMPLE badge. Ben called it gimmicky (2026-09-21)
    and he is right: it was a mockup dressed as an artifact, which is a
    weaker thing to show than nothing. The competitive review's point stands
    (four rivals promise documentation and none shows any), but the way to
    win it is ONE REAL REDACTED REPORT from a consenting client, not a
    drawing of one. Do not rebuild the mock.
  */}
  <ResponseCommitment />
  <PricingCards />

  <!-- AREAS -->
  <section class="section bg-white">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class="eyebrow">Where we work</p>
          <h2 class="h2 mt-2">Local crews across the North Shore &amp; Vancouver</h2>
        </div>
        <a href="/service-areas" class="btn-ghost-light">All service areas</a>
      </div>
      <ul class="mt-10 flex flex-wrap gap-2.5">
        {AREA_LINKS.map((area) => (
          <li>
            <a
              href={`/${area.slug}`}
              class="inline-block rounded-full border border-frost-200 bg-white px-4 py-2 text-sm font-medium text-ink-900 transition-colors hover:border-brand-500 hover:text-brand-600"
            >
              {area.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <FaqAccordion faqs={homeFaqs} />
  <CtaBand />
  <LocalBusinessSchema />
</Base>
