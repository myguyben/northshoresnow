# Copy to .env to run the tags locally. On production these are set as
# environment variables on the Render static site (srv-d6ktcmk50q8c73ecs1l0)
# — they are inlined at BUILD time, so changing one requires a redeploy, not
# just a restart.
#
# Every one is optional. With none set the site ships no third-party scripts
# at all, exactly as it did before ad tracking existed; UTM and click-id
# capture on the quote form keeps working either way.

# --- Google -----------------------------------------------------------------
# GA4 measurement id — Google Analytics > Admin > Data streams
PUBLIC_GA4_ID=G-XXXXXXXXXX

# Google Ads conversion id — Google Ads > Goals > Conversions > (any action)
# > Tag setup. Include the "AW-" prefix.
PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX

# Conversion LABELS, the part after the slash in the AW-123/abcDEF send_to
# value. One per conversion action.
PUBLIC_GOOGLE_ADS_LEAD_LABEL=
PUBLIC_GOOGLE_ADS_CALL_LABEL=

# Set to "true" only AFTER turning enhanced conversions on for the lead action
# inside Google Ads and accepting the customer-data terms. The site hashes the
# email with SHA-256 before it is sent.
PUBLIC_GOOGLE_ADS_ENHANCED=false

# --- Meta -------------------------------------------------------------------
# Pixel id — Meta Events Manager > Data sources
PUBLIC_META_PIXEL_ID=

# --- Quote endpoint ---------------------------------------------------------
# Defaults to production Icey; override to point a local site at a local Icey.
# PUBLIC_QUOTE_ENDPOINT=http://localhost:3000/api/inbound/website-lead
